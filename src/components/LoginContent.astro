---
interface Props {
  /** true のとき jQM 比較用のレガシーマークアップを出す */
  jqm?: boolean
}

const { jqm = false } = Astro.props
---

{
  jqm ? (
    <div class="content" data-role="content">
      <h1 class="title title_other">ログイン</h1>
      <div class="container">
        <div class="block">
          <p>メールアドレスでログイン</p>
          <form
            action="https://www.moratame.net/s/login/index2.php"
            method="post"
          >
            <div class="block_inner">
              <div data-role="fieldcontain">
                <label for="email" class="ui-hidden-accessible">
                  メールアドレス
                </label>
                <input
                  type="email"
                  name="email"
                  id="email"
                  placeholder="メールアドレス"
                  autocomplete="email"
                  data-theme="d"
                />
              </div>
              <div data-role="fieldcontain">
                <label for="pass" class="ui-hidden-accessible">
                  パスワード
                </label>
                <input
                  type="password"
                  name="pass"
                  id="pass"
                  placeholder="パスワード"
                  autocomplete="current-password"
                  data-theme="d"
                />
              </div>
              <input type="hidden" name="url" value="" />
            </div>

            <div class="answer13">
              <ul class="answerListUl">
                <li class="answerListLi">
                  <div class="answerListLiPd">
                    <label class="cbxbd c_on" for="auto-login">
                      <input
                        id="auto-login"
                        class="answer"
                        type="checkbox"
                        name="check"
                        value="on"
                        checked
                        data-role="none"
                      />
                    </label>
                    <div class="answerListTxt">
                      <p id="flowTxtColor3">
                        <label for="auto-login">次回から自動ログインする</label>
                        <a
                          href="https://www.moratame.net/wp/cs/?p=466"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          詳細
                        </a>
                      </p>
                    </div>

                    <br class="flowBrClear" />
                  </div>
                </li>
              </ul>
            </div>

            <div class="block_inner" data-mini="true">
              <button type="submit">ログインする</button>
              <p class="btnGry mt-20px">
                <a href="https://www.moratame.net/s/login/pass.php">
                  パスワードを忘れた方はこちら
                </a>
              </p>
            </div>
          </form>

          <div class="p-social_login">
            <div class="bl-8423-max-w-md bl-8423-px-4 bl-8423-mx-auto">
              <p
                class="p-social_login__lead bl-8423-font-bold bl-8423-mt-4 bl-8423-text-center bl-8423-bg-yellow-50 bl-8423-leading-snug bl-8423-pt-2 bl-8423-pb-4 bl-8423-relative"
                style="font-size: 16px"
              >
                ソーシャルアカウントでログイン
              </p>
              <form
                action="https://auth.attoos.jp/uauth/receive"
                method="post"
                id="attoos-login"
              >
                <input
                  type="hidden"
                  name="iv"
                  value="TVlPbTEyN3JPVXI0NGhIUGY5Q3JJTVlqYWd2UlFsaXNGSUp1NEhGb1hrRT0="
                />
                <input
                  type="hidden"
                  id="site_id"
                  name="site_id"
                  value="NWVwblNuZUFLRit5N3VMdTJXaElHZz09"
                />
                <input
                  type="hidden"
                  name="return_path"
                  value="https://www.moratame.net/login/after_attoos.php"
                />
                <input type="hidden" name="sns_id" id="sns_id" value="" />
                <ul class="bl-8423-list-none" style="margin-bottom: 24px;">
                  <li class="bl-8423-mt-4">
                    <a
                      href="https://www.moratame.net/?redirect_yahoo_auth_end_point=1"
                      class="u-btn-sns u-btn-sns--yahoo"
                      data-role="none"
                    >
                      <img
                        src="https://image.moratame.net/images/common/yahoo_japan_icon_w_64.png"
                        alt=""
                        width="64"
                        height="36"
                        class="bl-8423-left-2"
                      />
                      Yahoo! JAPAN IDでログイン
                    </a>
                  </li>
                  <li class="bl-8423-mt-4">
                    <a
                      href="#"
                      class="u-btn-sns u-btn-sns--apple bl-8423-text-left"
                      data-role="none"
                      onclick="return modeAttoosLogin(5);"
                    >
                      <i class="bi bi-apple bl-8423-left-2" />
                      Sign in with Apple
                    </a>
                  </li>
                  <li class="bl-8423-mt-4">
                    <a
                      href="#"
                      class="u-btn-sns u-btn-sns--facebook bl-8423-text-left"
                      data-role="none"
                      onclick="return modeAttoosLogin(2);"
                    >
                      <i class="bi bi-facebook bl-8423-left-2" />
                      Facebookでログイン
                    </a>
                  </li>
                  <li class="bl-8423-mt-4">
                    <a
                      href="#"
                      class="u-btn-sns u-btn-sns--line bl-8423-text-left"
                      data-role="none"
                      onclick="return modeAttoosLogin(3);"
                    >
                      <i class="bi bi-line bl-8423-left-2" />
                      Lineでログイン
                    </a>
                  </li>
                  <li class="bl-8423-mt-4">
                    <a
                      href="#"
                      class="u-btn-sns u-btn-sns--google bl-8423-text-left"
                      data-role="none"
                      onclick="return modeAttoosLogin(4);"
                    >
                      <i class="bi bi-google bl-8423-left-2" />
                      Googleでログイン
                    </a>
                  </li>
                </ul>
              </form>
            </div>
          </div>

          <p style="margin: 0 15px 20px; text-align: right;">
            <a href="/s/contents/signup.html">新規会員登録はこちらから</a>
          </p>
          <p style="margin: 0 15px 20px; text-align: right;">
            <a href="https://www.moratame.net/s/contents/about.php">
              モラタメ.net について詳しくはこちら
            </a>
          </p>
        </div>
      </div>
    </div>
  ) : (
    <div class="page-content page-content--muted">
      <div class="page-content__inner">
        <section>
          <div class="page-heading">
            <h1 class="heading heading--l">ログイン</h1>
          </div>

          <h2 class="heading heading--s login-section-title">
            メールアドレスでログイン
          </h2>

          <form
            action="https://www.moratame.net/s/login/index2.php"
            method="post"
          >
            <div class="login-credentials">
              <div class="field">
                <label class="u-sr-only" for="email">
                  メールアドレス
                </label>
                <input
                  type="email"
                  class="input"
                  name="email"
                  id="email"
                  placeholder="メールアドレス"
                  autocomplete="email"
                />
              </div>
              <div class="field">
                <label class="u-sr-only" for="pass">
                  パスワード
                </label>
                <input
                  type="password"
                  class="input"
                  name="pass"
                  id="pass"
                  placeholder="パスワード"
                  autocomplete="current-password"
                />
              </div>
            </div>
            <input type="hidden" name="url" value="" />

            <div class="field">
              <div class="check">
                <input
                  id="auto-login"
                  class="check__input"
                  type="checkbox"
                  name="check"
                  value="on"
                  checked
                />
                <label class="check__label" for="auto-login">
                  <span class="check__box" aria-hidden="true" />
                  次回から自動ログインする
                </label>
                <a
                  class="check__help"
                  href="https://www.moratame.net/wp/cs/?p=466"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="詳細"
                >
                  <span class="check__help-icon" aria-hidden="true" />
                </a>
              </div>
            </div>

            <!-- 本番 reCAPTCHA は読み込まない。見た目だけのモック -->
            <div class="captcha-mock" role="group" aria-label="ロボットでないことの確認（モック）">
              <div class="captcha-mock__main">
                <span class="captcha-mock__box" aria-hidden="true"></span>
                <p class="captcha-mock__label">私はロボットではありません</p>
              </div>
              <div class="captcha-mock__brand" aria-hidden="true">
                <span class="captcha-mock__brand-name">reCAPTCHA</span>
                <span class="captcha-mock__brand-links">プライバシー - 利用規約</span>
              </div>
            </div>
            <p class="captcha-mock__note">※モック表示です。検証は行いません。</p>

            <div class="form-actions form-actions--compact">
              <button
                type="submit"
                class="button button--green button--borderless"
              >
                ログインする
              </button>
            </div>
            <p class="form-note form-note--consent">
              <a
                class="text-link"
                href="https://www.moratame.net/s/login/pass.php"
              >
                パスワードを忘れた方はこちら
              </a>
            </p>
          </form>

          <div class="login-social">
            <p class="login-social__lead">ソーシャルアカウントでログイン</p>
            <form
              action="https://auth.attoos.jp/uauth/receive"
              method="post"
              id="attoos-login"
            >
              <input
                type="hidden"
                name="iv"
                value="TVlPbTEyN3JPVXI0NGhIUGY5Q3JJTVlqYWd2UlFsaXNGSUp1NEhGb1hrRT0="
              />
              <input
                type="hidden"
                id="site_id"
                name="site_id"
                value="NWVwblNuZUFLRit5N3VMdTJXaElHZz09"
              />
              <input
                type="hidden"
                name="return_path"
                value="https://www.moratame.net/login/after_attoos.php"
              />
              <input type="hidden" name="sns_id" id="sns_id" value="" />
              <ul class="login-social__list">
                <li>
                  <a
                    href="#"
                    class="login-social__link"
                    aria-label="Lineでログイン"
                    onclick="return modeAttoosLogin(3);"
                  >
                    <img
                      class="login-social__icon"
                      src="/icons/icon-line.svg"
                      alt=""
                      width="30"
                      height="30"
                    />
                  </a>
                </li>
                <li>
                  <a
                    href="#"
                    class="login-social__link"
                    aria-label="Googleでログイン"
                    onclick="return modeAttoosLogin(4);"
                  >
                    <img
                      class="login-social__icon"
                      src="/icons/icon-google.svg"
                      alt=""
                      width="30"
                      height="30"
                    />
                  </a>
                </li>
                <li>
                  <a
                    href="https://www.moratame.net/?redirect_yahoo_auth_end_point=1"
                    class="login-social__link"
                    aria-label="Yahoo! JAPAN IDでログイン"
                  >
                    <img
                      class="login-social__icon"
                      src="/icons/icon-yahoo.svg"
                      alt=""
                      width="30"
                      height="30"
                    />
                  </a>
                </li>
                <li>
                  <a
                    href="#"
                    class="login-social__link"
                    aria-label="Sign in with Apple"
                    onclick="return modeAttoosLogin(5);"
                  >
                    <img
                      class="login-social__icon"
                      src="/icons/icon-apple.svg"
                      alt=""
                      width="30"
                      height="30"
                    />
                  </a>
                </li>
                <li>
                  <a
                    href="#"
                    class="login-social__link"
                    aria-label="Facebookでログイン"
                    onclick="return modeAttoosLogin(2);"
                  >
                    <img
                      class="login-social__icon"
                      src="/icons/icon-facebook.svg"
                      alt=""
                      width="30"
                      height="30"
                    />
                  </a>
                </li>
              </ul>
            </form>
          </div>

          <ul class="login-links">
            <li class="login-links__item">
              <a class="text-link" href="/s/contents/signup.html">
                新規会員登録はこちらから
              </a>
            </li>
            <li class="login-links__item">
              <a
                class="text-link"
                href="https://www.moratame.net/s/contents/about.php"
              >
                モラタメ.net について詳しくはこちら
              </a>
            </li>
          </ul>
        </section>
      </div>
    </div>
  )
}

<script is:inline>
  function modeAttoosLogin(id) {
    $("#sns_id").val(id)
    $("#attoos-login").submit()
    return false
  }
</script>
