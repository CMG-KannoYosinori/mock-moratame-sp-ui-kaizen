---
import BaseLayout from "../../layouts/BaseLayout.astro"
import HeaderSimple from "../../components/HeaderSimple.astro"
import Footer from "../../components/Footer.astro"
import Stepper from "../../components/Stepper.astro"
---

<BaseLayout
  title="UI ライブラリー"
  pageId="registration-page"
  fixSmartBannerOffsetToPage
>
  <link slot="head" rel="stylesheet" href="/styles/theme-2026.css" />
  <link slot="head" rel="stylesheet" href="/styles/ui.css" />

  <HeaderSimple />

  <div class="page-content page-content--muted">
    <div class="page-content__inner">
    <ul class="paper-list">
      <li>
        <h3 class="heading heading--l">基本デザイン</h3>
        <ul class="paper-list">
          <li>
            <h3 class="heading heading--s">カラー</h3>
            <div class="paper">
              <ul class="color-list">
                <li>
                  <div class="color-box color-box--primary"></div>
                </li>
                <li>
                  <div class="color-box color-box--danger"></div>
                </li>
                <li>
                  <div class="color-box color-box--link"></div>
                </li>
                <li>
                  <div class="color-box color-box--input-border"></div>
                </li>
              </ul>
            </div>
          </li>
        </ul>
      </li>

      <li>
        <h3 class="heading heading--l">コンポーネント</h3>
        <ul class="paper-list">
          <li>
            <h3 class="heading heading--s">ステッパー</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <Stepper activeStep={1} />
                </div>
              </li>
              <li>
                <div class="paper">
                  <Stepper activeStep={2} />
                </div>
              </li>
              <li>
                <div class="paper">
                  <Stepper activeStep={3} />
                </div>
              </li>
              <li>
                <div class="paper">
                  <Stepper activeStep={4} />
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">ページ見出し</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <div class="page-heading">
                    <h1 class="heading heading--l">基本情報入力</h1>
                    <p class="page-heading__caption">
                      必須項目<span class="required-mark">＊</span>
                    </p>
                  </div>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">見出し</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <h3 class="heading heading--l">大見出し</h3>
                </div>
              </li>
              <li>
                <div class="paper">
                  <h3 class="heading heading--s">見出し</h3>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">必須マーク</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <span class="required-mark">＊</span>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">項目ヘッダー</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <div class="field-header">
                    <h2 class="heading heading--s">性別</h2>
                    <span class="required-mark">＊</span>
                  </div>
                </div>
              </li>
              <li>
                <div class="paper">
                  <div class="field-header">
                    <h2 class="heading heading--s">ニックネーム</h2>
                    <span class="required-mark">＊</span>
                    <p class="field-header__caption">※後から変更できます</p>
                  </div>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">項目</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <div class="field">
                    <div class="field-header">
                      <h2 class="heading heading--s">電話番号</h2>
                      <span class="required-mark">＊</span>
                    </div>
                    <input
                      type="tel"
                      class="input"
                      value=""
                      placeholder="09012345678"
                    />
                  </div>
                  <div class="field">
                    <div class="field-header">
                      <h2 class="heading heading--s">配信方法</h2>
                      <span class="required-mark">＊</span>
                    </div>
                    <ul class="radio">
                      <li class="radio__item">
                        <input
                          class="radio__input"
                          type="radio"
                          name="ui-delivery"
                          id="ui-delivery-sms"
                          value="1"
                          checked
                        />
                        <label class="radio__label" for="ui-delivery-sms">
                          <span class="radio__dot" aria-hidden="true"></span>
                          SMS配信
                        </label>
                      </li>
                      <li class="radio__item">
                        <input
                          class="radio__input"
                          type="radio"
                          name="ui-delivery"
                          id="ui-delivery-voice"
                          value="2"
                        />
                        <label class="radio__label" for="ui-delivery-voice">
                          <span class="radio__dot" aria-hidden="true"></span>
                          音声ガイダンス
                        </label>
                      </li>
                    </ul>
                  </div>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">入力</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <input
                    type="text"
                    class="input"
                    value=""
                    placeholder="example@moratame.net"
                  />
                </div>
              </li>
              <li>
                <div class="paper">
                  <div class="input-search">
                    <input
                      type="text"
                      class="input input--with-action"
                      value=""
                      placeholder="入力後、使用可能かチェック！"
                    />
                    <button
                      type="button"
                      class="input-search__button"
                      aria-label="ニックネームをチェック"
                    >
                      <img
                        class="input-search__icon"
                        src="/icons/search.svg"
                        alt=""
                        width="21"
                        height="22"
                        aria-hidden="true"
                      />
                    </button>
                  </div>
                </div>
              </li>
              <li>
                <div class="paper">
                  <input
                    type="text"
                    class="input input--error"
                    value="Example1"
                    placeholder="example@moratame.net"
                  />
                  <ul class="field-error">
                    <li class="field-error__item">
                      同一のE-mailアドレスが登録されています。
                    </li>
                  </ul>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">ニックネームチェック</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <div class="nickname-check">
                    <div class="nickname-check__result">
                      <p
                        class="nickname-check__status nickname-check__status--ok"
                      >
                        使用可能なニックネームです。
                      </p>
                    </div>
                  </div>
                </div>
              </li>
              <li>
                <div class="paper">
                  <div class="nickname-check">
                    <div class="nickname-check__result">
                      <p
                        class="nickname-check__status nickname-check__status--ng"
                      >
                        同一のニックネームが登録されています。
                      </p>
                      <p class="nickname-check__heading">
                        似たようなニックネーム
                      </p>
                      <ul class="nickname-check__list">
                        <li>
                          <button
                            type="button"
                            class="nickname-check__suggestion"
                          >
                            ポッケ1
                          </button>
                        </li>
                        <li>
                          <button
                            type="button"
                            class="nickname-check__suggestion"
                          >
                            ポッケ123456
                          </button>
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">セレクト</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <ul class="select">
                    <li class="select__item">
                      <select class="select__control">
                        <option>年</option>
                        <option value="1980" selected>1980</option>
                      </select>
                    </li>
                    <li class="select__item">
                      <select class="select__control">
                        <option>月</option>
                        <option value="01">01</option>
                      </select>
                    </li>
                    <li class="select__item">
                      <select class="select__control">
                        <option>日</option>
                        <option value="01">01</option>
                      </select>
                    </li>
                  </ul>
                </div>
              </li>
              <li>
                <div class="paper">
                  <ul class="select">
                    <li class="select__item">
                      <select class="select__control select__control--error">
                        <option>年</option>
                        <option value="2000" selected>2000</option>
                      </select>
                    </li>
                    <li class="select__item">
                      <select class="select__control select__control--error">
                        <option>月</option>
                        <option value="01" selected>01</option>
                      </select>
                    </li>
                    <li class="select__item">
                      <select class="select__control select__control--error">
                        <option>日</option>
                        <option value="01" selected>01</option>
                      </select>
                    </li>
                  </ul>
                  <ul class="field-error">
                    <li class="field-error__item">
                      生年月日を正しく選択してください。
                    </li>
                  </ul>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">ラジオ</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <ul class="radio">
                    <li class="radio__item">
                      <input
                        class="radio__input"
                        type="radio"
                        name="ui-sex[]"
                        id="ui-sex-1"
                        value="11001"
                      />
                      <label class="radio__label" for="ui-sex-1">
                        <span class="radio__dot" aria-hidden="true"></span>
                        男性
                      </label>
                    </li>
                    <li class="radio__item">
                      <input
                        class="radio__input"
                        type="radio"
                        name="ui-sex[]"
                        id="ui-sex-2"
                        value="11002"
                        checked
                      />
                      <label class="radio__label" for="ui-sex-2">
                        <span class="radio__dot" aria-hidden="true"></span>
                        女性
                      </label>
                    </li>
                    <li class="radio__item">
                      <input
                        class="radio__input"
                        type="radio"
                        name="ui-sex[]"
                        id="ui-sex-3"
                        value="11003"
                      />
                      <label class="radio__label" for="ui-sex-3">
                        <span class="radio__dot" aria-hidden="true"></span>
                        無回答
                      </label>
                    </li>
                  </ul>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">確認フィールド</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <div class="confirm-field">
                    <div class="field-header">
                      <h2 class="heading heading--s">メールアドレス</h2>
                    </div>
                    <p class="field-value">makiko.okamura@excrie.co.jp</p>
                  </div>
                  <div class="confirm-field">
                    <div class="field-header">
                      <h2 class="heading heading--s">ニックネーム</h2>
                    </div>
                    <p class="field-value">まこポッケ</p>
                  </div>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">テキストリンク</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <a class="text-link" href="#">利用規約</a>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">同意文</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <p class="form-consent">
                    <a class="text-link" href="#">利用規約</a
                    >に同意のうえ<br />「入力内容確認へ」を押してください。
                  </p>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">ぶら下げインデント</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <p class="hanging">
                    ※迷惑メールフィルタやドメイン指定受信を設定されている場合は、moratame.netからのメールが受信できるよう設定をお願いします。
                  </p>
                </div>
              </li>
              <li>
                <div class="paper">
                  <p class="hanging">
                    ・先頭が中黒の注記も同じクラスで、折り返し行が1文字分下がります。
                  </p>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">注記</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <p class="form-note hanging">
                    ※迷惑メールフィルタやドメイン指定受信を設定されている場合は、moratame.netからのメールが受信できるよう設定をお願いします。
                  </p>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">案内</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <p class="form-info">
                    モラタメでは、ご登録できるアカウントは、ご本人様かつお一人様1つまでとしています。詳しくは、<a
                      class="text-link"
                      href="https://www.moratame.net/contents/regulation.php"
                      >「ご利用にあたってのお約束ごと」</a
                    >をご確認ください。
                  </p>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">フォームエラー</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <p class="form-error" role="alert">
                    入力内容をご確認ください。
                  </p>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">項目エラー</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <ul class="field-error">
                    <li class="field-error__item">
                      E-mailは必須入力です。
                    </li>
                    <li class="field-error__item">
                      E-mailが正しくありません。
                    </li>
                  </ul>
                </div>
              </li>
            </ul>
          </li>
          <li>
            <h3 class="heading heading--s">ボタン</h3>
            <ul class="paper-list">
              <li>
                <div class="paper">
                  <button
                    type="button"
                    class="button button--green button--borderless"
                    >入力内容確認へ</button
                  >
                </div>
              </li>
              <li>
                <div class="paper">
                  <a href="#" class="button button--outline">内容を修正する</a>
                </div>
              </li>
            </ul>
          </li>
        </ul>
      </li>
    </ul>
    </div>
  </div>

  <Footer variant="simple" engine="css" />
</BaseLayout>
