---
import BaseLayout from "../../../layouts/BaseLayout.astro"
import HeaderSimple from "../../../components/HeaderSimple.astro"
import Footer from "../../../components/Footer.astro"
import Stepper from "../../../components/Stepper.astro"
---

<BaseLayout
  title="新規会員登録（完了）"
  pageId="registration-page"
  fixSmartBannerOffsetToPage
>
  <link slot="head" rel="stylesheet" href="/styles/theme-2026.css" />

  <HeaderSimple />

  <div class="page-content page-content--muted">
    <div class="page-content__inner">
      <section>
        <Stepper activeStep={4} />
        <div class="page-heading">
          <h1 class="heading heading--l">会員登録完了</h1>
        </div>

        <div class="page-content__lead">
          <p>makiko.okamura@excrie.co.jp にメールを送信しました。</p>
          <p>
            もしメールが届いていない場合、ご登録いただいたメールアドレスが誤っている可能性がありますので、<a
              class="text-link"
              href="https://www.moratame.net/s/mypage/">登録情報変更</a
            >よりメールアドレスを変更ください。
          </p>
        </div>

        <a
          href="https://www.moratame.net/"
          class="button button--green button--borderless">トップページへ戻る</a
        >
      </section>
    </div>
  </div>

  <Footer variant="simple" engine="css" />
</BaseLayout>
