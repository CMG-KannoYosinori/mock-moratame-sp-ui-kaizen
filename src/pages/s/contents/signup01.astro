---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeaderSimple from '../../../components/HeaderSimple.astro';
import Footer from '../../../components/Footer.astro';

const years = Array.from({ length: 2021 - 1934 + 1 }, (_, i) => 1934 + i);
const months = Array.from({ length: 12 }, (_, i) => String(i + 1).padStart(2, '0'));
const days = Array.from({ length: 31 }, (_, i) => String(i + 1).padStart(2, '0'));
---

<BaseLayout title="新規会員登録" pageId="registration-page" includeJqueryMobileJs>
  <link
    slot="head"
    rel="stylesheet"
    href="https://www.moratame.net/s/css/member-registration.css?2026061217"
  />
  <link slot="head" rel="stylesheet" href="https://www.moratame.net/s/css/colorbox.css" />
  <script slot="head" is:inline src="https://www.moratame.net/s/js/jquery.colorbox.js" charset="UTF-8"></script>
  <script slot="head" is:inline src="https://www.moratame.net/s/js/hideShowPassword.js"></script>

  <script is:inline>
    $(document).ready(function () {
      $('#nickname').html(
        '<input type="submit" name="name_check" value="登録可能なニックネームかチェック" class="w200 nickname-check-btn" onclick="javascript:return namecheck();" />'
      );
      $('#zip1').html(
        '<input type="submit" name="zip1_input" value="郵便番号を元に住所を記入する" class="w200" onclick="javascript:return searchaddr(10);" />'
      );
      $('#zip2').html(
        '<input type="submit" name="zip2_input" value="郵便番号を元に住所を記入する" class="w200" onclick="javascript:return searchaddr(20);" />'
      );
    });

    function namecheck() {
      $('#mode').val(1);
      var url = 'profile_edit.exec.php';
      var params = $('#new-signup-input').serialize();
      $.post(
        url,
        { params: params },
        function (data, status) {
          if (data.status == '0') {
            $('#nicknamealert').html("<p class='message ng'>" + data.message + '<p />');
          } else if (data.status == '1') {
            $('#nicknamealert').html("<p class='message ok'>" + data.message + '<p />');
          }
        },
        'json'
      );
      return false;
    }

    function searchaddr(prefix) {
      $('#mode').val(prefix);
      var url = 'profile_edit.exec.php';
      var params = $('#new-signup-input').serialize();
      $.post(
        url,
        { params: params },
        function (data, status) {
          if (data.status == '0') {
            $('#zipalert' + prefix).html('<p class="message zip">' + data.message + '<p />');
          } else if (data.status == '1') {
            $('#warning').html(data.message);
            $('#addr1' + prefix).val(data.addr1);
            $('#addr2' + prefix).val(data.addr2 + data.addr3);
            $('#zipalert' + prefix).html('');
          }
        },
        'json'
      );
      return false;
    }

    function daychange() {
      $('#mode').val('lastday');
      var url = 'profile_edit.exec.php';
      var params = $('#new-signup-input').serialize();
      $.post(
        url,
        { params: params },
        function (data, status) {
          if (data.status == '1') {
            var cur = $('#day').val();
            for (var i = 28; i <= 31; i++) {
              $('#day' + i).remove();
            }
            var max = parseInt(data.day);
            for (var i = 28; i <= max; i++) {
              $('#day').append(
                '<option id="day' + i + '" name="' + i + '" value="' + i + '">' + i + '</option>'
              );
            }
            if (cur > max) {
              cur = max;
            }
            $('#day').val(cur);
          }
        },
        'json'
      );
    }

    $(function () {
      $('[name="job[]"]').css('width', '270px').css('overflow', 'hidden');
    });
  </script>

  <div id="modal_wd">
    <div class="md_background"></div>
    <div class="md_container"></div>
  </div>

  <HeaderSimple />

  <div id="contente-top" class="content">
    <div class="container">
      <section class="new-signup-input">
        <p class="milesstone">
          <img src="https://www.moratame.net/img/milestone-1.png" alt="step1 基本情報入力" />
        </p>
        <h1 class="heading-ttl">基本情報入力</h1>
        <div class="form_error">
          <div class="form_error_body">入力内容をご確認ください。</div>
        </div>

        <form
          action="https://www.moratame.net/s/contents/signup02p.php"
          method="post"
          name="new-signup-input"
          id="new-signup-input"
        >
          <input type="hidden" name="mode" id="mode" value="" />
          <div class="input-area" style="margin-bottom: 15px;">
            <p class="error">入力内容に不備があります。</p>
          </div>

          <div class="select-area select-sex">
            <div class="form-ttl">
              <h2 class="element-ttl">性別</h2>
              <span class="required">必須</span>
            </div>
            <div class="input-area">
              <ul class="radio-menu sexs">
                <li>
                  <input type="radio" name="sex[]" id="sex-1" value="11001" /><label for="sex-1">男性</label>
                </li>
                <li>
                  <input type="radio" name="sex[]" id="sex-2" value="11002" checked /><label for="sex-2"
                    >女性</label
                  >
                </li>
                <li>
                  <input type="radio" name="sex[]" id="sex-3" value="11003" /><label for="sex-3">無回答</label>
                </li>
              </ul>
            </div>
          </div>

          <div class="select-area select-birthday">
            <div class="form-ttl">
              <h2 class="element-ttl">生年月日</h2>
              <span class="required">必須</span>
            </div>
            <div class="input-area">
              <ul class="select-menu birthday">
                <li>
                  <select name="yyyy" onchange="javascript: daychange();" data-role="none">
                    <option>年</option>
                    {
                      years.map((year) => (
                        <option value={year} selected={year === 1980}>
                          {year}
                        </option>
                      ))
                    }
                  </select>
                </li>
                &nbsp;
                <li>
                  <select name="mm" onchange="javascript: daychange();" data-role="none">
                    <option>月</option>
                    {
                      months.map((month) => (
                        <option value={month}>{month}</option>
                      ))
                    }
                  </select>
                </li>
                &nbsp;
                <li>
                  <select name="dd" id="day" onchange="javascript: daychange();" data-role="none">
                    <option>日</option>
                    {
                      days.map((day) => (
                        <option id={`day${Number(day)}`} value={day}>
                          {day}
                        </option>
                      ))
                    }
                  </select>
                </li>
              </ul>
            </div>
          </div>

          <div class="select-area select-email">
            <div class="form-ttl">
              <h2 class="element-ttl">メールアドレス</h2>
              <span class="required">必須</span>
            </div>
            <div class="input-area">
              <ul class="input-menu email">
                <li>
                  <input
                    type="text"
                    class="fs-15"
                    name="email"
                    id="email"
                    value=""
                    placeholder="example@moratame.net"
                    autocomplete="off"
                    spellcheck="false"
                    autocorrect="off"
                  />
                </li>
                <li>
                  <input
                    type="text"
                    class="fs-15"
                    name="email2"
                    id="email2"
                    value=""
                    placeholder="確認のためもう一度入力して下さい"
                    autocomplete="off"
                    spellcheck="false"
                    autocorrect="off"
                  />
                </li>
              </ul>
              <p class="error">同一のE-mailアドレスが登録されています。<br /></p>
            </div>
          </div>

          <div class="select-area select-password">
            <div class="form-ttl">
              <h2 class="element-ttl">パスワード</h2>
              <span class="required">必須</span>
            </div>
            <div class="input-area">
              <ul class="input-menu password">
                <li>
                  <input
                    type="password"
                    name="pass"
                    id="password1"
                    placeholder="g10Asf31"
                    autocomplete="off"
                    spellcheck="false"
                    autocorrect="off"
                  />
                </li>
                <p class="side-text">※半角6文字以上16文字以下</p>
              </ul>
            </div>
          </div>

          <div class="select-area select-nickname">
            <div class="form-ttl">
              <h2 class="element-ttl">ニックネーム</h2>
              <span class="required">必須</span>
            </div>
            <div class="input-area">
              <ul class="input-menu nickname">
                <li>
                  <input
                    type="text"
                    class="fs-15"
                    name="disp_id"
                    id="disp_id"
                    value=""
                    placeholder="ザック32694"
                    onblur="javascript:return namecheck();"
                  />
                </li>
                <div class="side-text">
                  <span id="nickname"></span>
                  <span id="nicknamealert"></span>
                </div>
              </ul>
              <p class="side-text">※ニックネームは後から変更できます。</p>
              <p class="error">ニックネームは必須入力です。<br /></p>
              <p class="error">同一のニックネームが登録されています。<br /></p>
            </div>
          </div>

          <div class="select-area select-nickname">
            <div class="form-ttl">
              <h2 class="element-ttl">紹介コード</h2>
            </div>
            <div class="input-area">
              <ul class="input-menu nickname">
                <li>
                  <input type="text" class="fs-15" name="refer_code" id="refer_code" value="" placeholder="" />
                </li>
                <div class="side-text">
                  <span id="nickname"></span>
                  <span id="nicknamealert"></span>
                </div>
              </ul>
              <p class="error">紹介コードが正しくありません。<br /></p>
            </div>
          </div>

          <div class="submit-area">
            <a class="iframe c_blue" href="https://www.moratame.net/s/contents/step01_guide.html">利用規約</a>に同意のうえ<br
            />「入力内容確認へ」を押してください。
          </div>
          <div class="submit-btn">
            <div class="btn-wrapper">
              <button type="submit" data-role="none">入力内容確認へ</button>
            </div>
          </div>
        </form>
      </section>
    </div>
  </div>

  <Footer variant="simple" />

  <script slot="after-page" is:inline>
    $('#password-2').hidePassword('focus', {
      toggle: { className: 'my-toggle' },
    });
  </script>
  <script slot="after-page" is:inline>
    $(function () {
      $('.iframe').colorbox({
        iframe: true,
        width: '90%',
        height: '80%',
        opacity: 0.7,
      });
    });
  </script>
</BaseLayout>
