import Footer from '../../../components/Footer.astro';
import NimatomeCart from '../../../components/NimatomeCart.astro';
import LoginContent from '../../../components/LoginContent.astro';
---

<BaseLayout title="ログイン（jQuery Mobile あり）" includeJqueryMobileJs includeJqueryMobileCss>
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css"
  />

  <Drawer />
  <HeaderApp showGuestNav />
  <LoginContent jqm />
  <Footer variant="app" />
  <NimatomeCart />
</BaseLayout>
